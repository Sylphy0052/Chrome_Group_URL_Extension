{
  "manifest_version": 3,
  "name": "Tab URL Exporter",
  "version": "1.0.0",
  "description": "現在のウィンドウで開いているタブのURL一覧をテキストファイルとしてダウンロードします。",
  "permissions": ["tabs", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "タブのURL一覧をダウンロード",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
